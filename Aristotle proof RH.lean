/-
The L-function as defined (via integral) is not symmetric because the integral diverges for Re(s) <= 1, while the symmetry would map these to convergent values.
-/
theorem PrimeInertia_Generates_Symmetry_False
  (θ : ThetaKernel) (h_inertia : HasPrimeInertia θ)
  (h_lim : Filter.Tendsto (fun y : ℝ => θ (Complex.I * y)) Filter.atTop (nhds 1))
  (h_pos : ∀ y : ℝ, 0 < y → 0 < (θ (Complex.I * y)).re - 1)
  (h_L2_ne_zero : PrimeInertia_L_Function θ 2 ≠ 0) :
  ¬ (∀ (s : ℂ), s ≠ 0 → s ≠ 1 → PrimeInertia_L_Function θ s = PrimeInertia_L_Function θ (1 - s)) := by
  intro h_symm
  have h_neg_one : PrimeInertia_L_Function θ (-1) = 0 := by
    apply PrimeInertia_L_Function_divergence_at_neg_one θ h_inertia h_lim
    intro y hy
    specialize h_pos y hy
    linarith
  have h_contra : PrimeInertia_L_Function θ (-1) = PrimeInertia_L_Function θ 2 := by
    convert h_symm (-1) (by norm_num) (by norm_num) using 2
    norm_num
  rw [h_neg_one] at h_contra
  rw [← h_contra] at h_L2_ne_zero
  contradiction
